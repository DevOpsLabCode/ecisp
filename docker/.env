VCS_REF=$(git rev-parse --short HEAD)
VCS_URL=''
VERSION='5.13.0-01'
BUILD_DATE=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
VENDOR='nccgroup'
NAME='enterprise-cloud-discovery-engine'
CLOUD='base'
DESCRIPTION='Enterprise Cloud Discovery Engine container based on Ubuntu.'
IMAGE_NAME="${VENDOR}/${NAME}-${CLOUD}:${VERSION}"

# These are passed in as env vars to the container at runtime
DEBIAN_FRONTEND=noninteractive
TERM=linux
