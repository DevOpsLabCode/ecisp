# Copy to ui/.env (gitignored) and fill in real values. docker compose
# auto-loads .env from this directory -- see docker-compose.yml.
#
# GitHub OAuth App for the "Connect GitHub" private-repo code-scan flow.
# Register at https://github.com/settings/applications/new with:
#   Homepage URL:               http://localhost:8080
#   Authorization callback URL: http://localhost:8000/api/github/oauth/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Runtime Defender containment DB (docker-compose.yml's `db` service).
# Defaults to "golem-dev-only" if left unset -- fine for local dev, not for
# anything that leaves your machine.
POSTGRES_PASSWORD=
